# Supabase — get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-secret"

# Client-side (must match above — VITE_ prefix exposes to browser, safe for anon key only)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Google Gemini — get from: https://aistudio.google.com/apikey
# Server-only: used by api/mentor.js (Vercel) and the dev server. Never add a
# VITE_ copy — that would publish the key inside the browser bundle.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: comma-separated model fallback list (default: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash-lite,gemini-3.5-flash"

# Admin signup verification code — set this to enable admin onboarding via invite code
ADMIN_SIGNUP_CODE="your-admin-signup-code"
